+    // bun-legacy: roundsd/roundss are SSE4.1. Callers like the DFG check supportsFloatingPointRounding() first, but
+    // the wasm BBQ and OMG tiers call these unconditionally, which SIGILLs on Core 2 / Pentium Dual-Core / Athlon 64.
+    // Without SSE4.1, round through a 64-bit integer with SSE2 instead, keeping roundsd/roundss semantics: the sign
+    // of zero, NaN quieted, and values too large to have a fraction (and infinities) returned unchanged. Uses only
+    // the macro scratch registers (r11, xmm15), so src may equal dst.
+    template<bool isFloat>
+    void roundWithoutSSE4_1(FPRegisterID src, FPRegisterID dst, LegacyRounding mode)
+    {
+        RegisterID integer = scratchRegister();
+        FPRegisterID x = fpTempRegister;
+        moveDouble(src, x);
+        // cvt*2si rounds as MXCSR says, which JSC leaves at round to nearest, ties to even.
+        if (mode == LegacyRounding::Nearest) {
+            if constexpr (isFloat)
+                m_assembler.cvtss2siq_rr(x, integer);
+            else
+                m_assembler.cvtsd2siq_rr(x, integer);
+        } else {
+            if constexpr (isFloat)
+                m_assembler.cvttss2siq_rr(x, integer);
+            else
+                m_assembler.cvttsd2siq_rr(x, integer);
+        }
+        // NaN, infinities and |x| >= 2^63 give INT64_MIN. Doubling overflows for it and for every |result| >= 2^62,
+        // where x has no fractional part anyway.
+        Jump special = branchAdd64(Overflow, integer, integer);
+        rshift64(TrustedImm32(1), integer);
+        auto convert = [&] {
+            if constexpr (isFloat)
+                m_assembler.cvtsi2ssq_rr(integer, dst);
+            else
+                m_assembler.cvtsi2sdq_rr(integer, dst);
+        };
+        convert();
+        if (mode == LegacyRounding::Floor || mode == LegacyRounding::Ceil) {
+            // Truncation went the wrong way for a negative (floor) or positive (ceil) non-integer: step once.
+            DoubleCondition alreadyRight = mode == LegacyRounding::Floor ? DoubleLessThanOrEqualAndOrdered : DoubleGreaterThanOrEqualAndOrdered;
+            Jump exact = isFloat ? branchFloat(alreadyRight, dst, x) : branchDouble(alreadyRight, dst, x);
+            if (mode == LegacyRounding::Floor)
+                sub64(TrustedImm32(1), integer);
+            else
+                add64(TrustedImm32(1), integer);
+            convert();
+            exact.link(this);
+        }
+        // A zero result has the sign of x: dst is +0 here, so 0 * x.
+        Jump nonZero = branchTest64(NonZero, integer, integer);
+        if constexpr (isFloat)
+            m_assembler.mulss_rr(x, dst);
+        else
+            m_assembler.mulsd_rr(x, dst);
+        nonZero.link(this);
+        Jump done = jump();
+
+        special.link(this);
+        moveDouble(x, dst);
+        Jump notNaN = isFloat ? branchFloat(DoubleEqualAndOrdered, x, x) : branchDouble(DoubleEqualAndOrdered, x, x);
+        if constexpr (isFloat)
+            m_assembler.addss_rr(dst, dst);
+        else
+            m_assembler.addsd_rr(dst, dst);
+        notNaN.link(this);
+        done.link(this);
+    }
